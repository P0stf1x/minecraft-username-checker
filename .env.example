# Charset to be going through
# Type: str, Default: 1234567890_qwertyuiopasdfghjklzxcvbnm (all the accepted symbols in minecraft username)
SEARCH_CHARSET=1234567890_qwertyuiopasdfghjklzxcvbnm

# Minimum character count to be checked
# Type: int, Default: 3
SEARCH_MIN_LENGTH=3

# Maximum character count to be checked
# Type: int, Default: 3
SEARCH_MAX_LENGTH=3

# Amount of time to sleep between sending checking the next batch of usernames
# Most Mojang APIs are limited to 200 requests per 2 minutes, so you'll be
# rate limited if set below 0.6 with more than 2000 usernames to check
# Type: float, Default: 1.0
SEARCH_SLEEP_TIME=1.0

# Timeout for API calls. In case of bad internet connection
# Type: int, Default: 60
SEARCH_API_TIMEOUT=60

# Send notification about finishing the job to ntfy.sh
# Type: bool, Default: false
NTFY_ENABLED=false

# ntfy.sh host for self-hosted notifications
# Type: str, Default: https://ntfy.sh
NTFY_HOST=https://ntfy.sh

# ntfy.sh topic
# Type: str, No Default, Required if NTFY_ENABLED=true
NTFY_TOPIC=example
